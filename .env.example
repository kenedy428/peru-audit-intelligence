# Dedicated Docker database. Never point this project at the host PostgreSQL on 5432.
POSTGRES_USER=audit
# Replace locally with a random URL-safe password. No default password in Compose.
POSTGRES_PASSWORD=replace_with_random_urlsafe_password
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5433/audit_intelligence
# For keyword-only development without Docker, override DATABASE_URL with:
# DATABASE_URL=sqlite:///data/local/audit.db
DATA_DIR=data/raw
CHUNK_WORDS=180
CHUNK_OVERLAP_WORDS=30
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768
LLM_MODEL=
# Disabled until a local model is installed and citations have been evaluated.
GENERATION_ENABLED=false
# Provisional retrieval gate, not a confidence probability; calibrate on real questions.
MIN_SEMANTIC_SCORE=0.6
API_URL=http://127.0.0.1:8000
